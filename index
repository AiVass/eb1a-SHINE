        <h1 style={{
          fontSize: "clamp(24px, 4vw, 42px)",
          fontWeight: "700",
          lineHeight: "1.2",
          margin: "0 0 16px",
          color: "#f0e8d0",
          letterSpacing: "-0.5px",
        }}>
          The Complete EB-1A Self-Petition System
        </h1>
        <p style={{
          fontSize: "17px",
          color: "#a09080",
          maxWidth: "620px",
          margin: "0 auto 24px",
          fontStyle: "italic",
        }}>
          32 artifacts · 7 phases · From first assessment to USCIS filing
        </p>
        <div style={{ display: "flex", justifyContent: "center", gap: "32px", flexWrap: "wrap" }}>
          {[
            { label: "Phases", value: "7" },
            { label: "Total Artifacts", value: String(totalArtifacts) },
            { label: "Criteria Covered", value: "9/10" },
            { label: "Target Timeline", value: "4–6 mo" },
          ].map(s => (
            <div key={s.label} style={{ textAlign: "center" }}>
              <div style={{ fontSize: "28px", fontWeight: "700", color: "#C9A84C", lineHeight: 1 }}>{s.value}</div>
              <div style={{ fontSize: "11px", color: "#806050", letterSpacing: "1px", textTransform: "uppercase", fontFamily: "Arial, sans-serif", marginTop: "4px" }}>{s.label}</div>
            </div>
          ))}
        </div>
      </div>

      {/* Legend */}
      <div style={{
        padding: "16px 40px",
        borderBottom: "1px solid #ffffff11",
        display: "flex",
        gap: "24px",
        flexWrap: "wrap",
        alignItems: "center",
        background: "#0d0d18",
        fontFamily: "Arial, sans-serif",
        fontSize: "12px",
      }}>
        <span style={{ color: "#606070" }}>Priority:</span>
        {[
          { label: "CRITICAL", color: "#ff6b6b", bg: "#DC262622", border: "#DC2626" },
          { label: "HIGH", color: "#f59e0b", bg: "#D9770622", border: "#D97706" },
          { label: "MODERATE", color: "#4ade80", bg: "#2E8B5722", border: "#2E8B57" },
          { label: "OPTIONAL", color: "#60a5fa", bg: "#4A7FC122", border: "#4A7FC1" },
        ].map(l => (
          <span key={l.label} style={{
            display: "inline-flex", alignItems: "center", gap: "6px",
            background: l.bg, border: `1px solid ${l.border}`,
            borderRadius: "4px", padding: "2px 10px", color: l.color,
            fontWeight: "700", letterSpacing: "0.5px",
          }}>{l.label}</span>
        ))}
        <span style={{ color: "#606070", marginLeft: "auto" }}>Click any artifact for full detail</span>
      </div>

      {/* Phase Grid */}
      <div style={{ padding: "32px 24px 64px", maxWidth: "1400px", margin: "0 auto" }}>
        {phases.map((phase) => (
          <div key={phase.id} style={{ marginBottom: "40px" }}>
            {/* Phase Header */}
            <div
              onClick={() => setExpandedPhase(expandedPhase === phase.id ? null : phase.id)}
              style={{
                display: "flex",
                alignItems: "center",
                gap: "16px",
                marginBottom: "20px",
                cursor: "pointer",
                userSelect: "none",
              }}
            >
              <div style={{
                width: "48px", height: "48px",
                borderRadius: "50%",
                background: phase.bg,
                border: `2px solid ${phase.color}`,
                display: "flex", alignItems: "center", justifyContent: "center",
                fontSize: "16px", fontWeight: "700",
                color: phase.color,
                fontFamily: "Arial, sans-serif",
                flexShrink: 0,
              }}>
                {phase.id}
              </div>
              <div style={{ flex: 1 }}>
                <div style={{ display: "flex", alignItems: "baseline", gap: "12px" }}>
                  <span style={{ fontSize: "11px", color: phase.color, letterSpacing: "2px", textTransform: "uppercase", fontFamily: "Arial, sans-serif" }}>{phase.label}</span>
                  <h2 style={{ fontSize: "22px", fontWeight: "700", color: "#f0e8d0", margin: 0, letterSpacing: "-0.3px" }}>
                    {phase.title}
                  </h2>
                  <span style={{ fontSize: "15px", color: "#706050", fontStyle: "italic" }}>— {phase.subtitle}</span>
                </div>
              </div>
              <div style={{
                background: phase.bg,
                border: `1px solid ${phase.color}44`,
                borderRadius: "4px",
                padding: "4px 12px",
                fontSize: "12px",
                color: phase.color,
                fontFamily: "Arial, sans-serif",
              }}>
                {phase.artifacts.length} artifact{phase.artifacts.length > 1 ? "s" : ""}
              </div>
              <span style={{ color: phase.color, fontSize: "18px" }}>
                {expandedPhase === phase.id ? "▲" : "▼"}
              </span>
            </div>

            {/* Connector line */}
            <div style={{
              height: "1px",
              background: `linear-gradient(to right, ${phase.color}44, transparent)`,
              marginBottom: "20px",
            }} />

            {/* Artifacts Grid */}
            <div style={{
              display: "grid",
              gridTemplateColumns: "repeat(auto-fill, minmax(320px, 1fr))",
              gap: "16px",
            }}>
              {phase.artifacts.map((artifact) => {
                const urg = urgencyStyle[artifact.urgency] || urgencyStyle["OPTIONAL"];
                const isSelected = selected?.id === artifact.id;
                const isFork = artifact.isFork;
                const pathColor = artifact.pathTag === "FOUNDER" ? "#C9A84C" : artifact.pathTag === "SPECIALIST" ? "#4A7FC1" : null;

                // Fork card gets full-width special treatment
                if (isFork) {
                  return (
                    <div
                      key={artifact.id}
                      onClick={() => setSelected(isSelected ? null : artifact)}
                      style={{
                        gridColumn: "1 / -1",
                        background: isSelected ? "#161620" : "#0f0f1a",
                        border: `1px solid #C9A84C66`,
                        borderRadius: "10px",
                        padding: "24px",
                        cursor: "pointer",
                        boxShadow: "0 0 32px #C9A84C11",
                      }}
                    >
                      <div style={{ display: "flex", alignItems: "center", gap: "12px", marginBottom: "16px", flexWrap: "wrap" }}>
                        <span style={{ background: "#C9A84C22", border: "1px solid #C9A84C", borderRadius: "4px", padding: "2px 10px", fontSize: "11px", color: "#C9A84C", fontFamily: "Arial, sans-serif", fontWeight: "700" }}>
                          {artifact.id}
                        </span>
                        <h3 style={{ fontSize: "16px", fontWeight: "700", color: "#f0e8d0", margin: 0 }}>
                          {artifact.title}
                        </h3>
                        <span style={{ background: "#DC262622", border: "1px solid #DC2626", borderRadius: "4px", padding: "2px 10px", fontSize: "10px", color: "#ff6b6b", fontFamily: "Arial, sans-serif", fontWeight: "700", marginLeft: "auto" }}>
                          🔀 ROUTING FORK — answer this before anything else
                        </span>
                      </div>

                      <div style={{ display: "grid", gridTemplateColumns: "1fr 1fr", gap: "16px", marginBottom: "16px" }}>
                        {artifact.forkPaths.map((fp) => (
                          <div key={fp.label} style={{
                            background: fp.color + "11",
                            border: `1px solid ${fp.color}55`,
                            borderRadius: "8px",
                            padding: "16px",
                          }}>
                            <div style={{ fontSize: "12px", fontWeight: "700", color: fp.color, fontFamily: "Arial, sans-serif", letterSpacing: "1px", marginBottom: "8px" }}>
                              {fp.label}
                            </div>
                            <p style={{ fontSize: "13px", color: "#a09080", lineHeight: "1.6", margin: 0, fontFamily: "Georgia, serif" }}>
                              {fp.desc}
                            </p>
                          </div>
                        ))}
                      </div>

                      {isSelected && (
                        <p style={{ fontSize: "13.5px", color: "#b0a898", lineHeight: "1.7", margin: "0", fontFamily: "Georgia, serif", borderTop: "1px solid #ffffff14", paddingTop: "14px" }}>
                          {artifact.description}
                        </p>
                      )}
                    </div>
                  );
                }

                return (
                  <div
                    key={artifact.id}
                    onClick={() => setSelected(isSelected ? null : artifact)}
                    style={{
                      background: isSelected ? "#161620" : "#0f0f1a",
                      border: isSelected ? `1px solid ${pathColor || phase.color}` : pathColor ? `1px solid ${pathColor}44` : "1px solid #ffffff14",
                      borderRadius: "10px",
                      padding: "20px",
                      cursor: "pointer",
                      transition: "all 0.2s ease",
                      transform: isSelected ? "translateY(-2px)" : "none",
                      boxShadow: isSelected ? `0 8px 32px ${phase.color}22` : "none",
                    }}
                  >
                    {/* Card header */}
                    <div style={{ display: "flex", alignItems: "flex-start", justifyContent: "space-between", gap: "8px", marginBottom: "10px" }}>
                      <div style={{
                        background: "#ffffff08",
                        border: "1px solid #ffffff14",
                        borderRadius: "4px",
                        padding: "2px 8px",
                        fontSize: "11px",
                        color: phase.color,
                        fontFamily: "Arial, sans-serif",
                        fontWeight: "700",
                        letterSpacing: "0.5px",
                        flexShrink: 0,
                      }}>
                        {artifact.id}
                      </div>
                      <span style={{
                        background: urg.bg,
                        border: `1px solid ${urg.border}`,
                        borderRadius: "4px",
                        padding: "2px 8px",
                        fontSize: "10px",
                        color: urg.text,
                        fontFamily: "Arial, sans-serif",
                        fontWeight: "700",
                        letterSpacing: "0.3px",
                        textAlign: "right",
                      }}>
                        {artifact.urgency.replace("CRITICAL — ", "CRITICAL").replace("HIGH — ", "HIGH").replace("MODERATE — ", "MOD.")}
                      </span>
                    </div>

                    <h3 style={{
                      fontSize: "15px",
                      fontWeight: "700",
                      color: "#e8e0d0",
                      margin: "0 0 6px",
                      lineHeight: "1.3",
                    }}>
                      {artifact.title}
                    </h3>

                    {artifact.pathTag && (
                      <div style={{
                        display: "inline-block",
                        background: pathColor + "22",
                        border: `1px solid ${pathColor}66`,
                        borderRadius: "4px",
                        padding: "2px 10px",
                        fontSize: "10px",
                        color: pathColor,
                        fontFamily: "Arial, sans-serif",
                        fontWeight: "700",
                        letterSpacing: "1px",
                        marginBottom: "8px",
                      }}>
                        {artifact.pathTag === "FOUNDER" ? "🏢 FOUNDER PATH" : "👤 SPECIALIST PATH"}
                      </div>
                    )}

                    <div style={{
                      fontSize: "12px",
                      color: typeColors[artifact.type] || "#C9A84C",
                      fontFamily: "Arial, sans-serif",
                      marginBottom: "12px",
                    }}>
                      {artifact.format}
                    </div>

                    {/* Input/Output */}
                    <div style={{
                      background: "#ffffff06",
                      borderRadius: "6px",
                      padding: "10px 12px",
                      marginBottom: "12px",
                      fontSize: "12px",
                      fontFamily: "Arial, sans-serif",
                      lineHeight: "1.6",
                    }}>
                      <div style={{ color: "#606070", marginBottom: "4px" }}>
                        <span style={{ color: "#4A7FC1" }}>IN:</span> {artifact.input}
                      </div>
                      <div style={{ color: "#606070" }}>
                        <span style={{ color: "#2E8B57" }}>OUT:</span> {artifact.output}
                      </div>
                    </div>

                    {/* Expanded detail */}
                    {isSelected && (
                      <div style={{
                        borderTop: "1px solid #ffffff14",
                        paddingTop: "12px",
                        marginTop: "4px",
                      }}>
                        <p style={{
                          fontSize: "13.5px",
                          color: "#b0a898",
                          lineHeight: "1.7",
                          margin: "0 0 10px",
                          fontFamily: "Georgia, serif",
                        }}>
                          {artifact.description}
                        </p>
                        <div style={{
                          fontSize: "11px",
                          color: "#706050",
                          fontFamily: "Arial, sans-serif",
                          letterSpacing: "0.3px",
                        }}>
                          FEEDS INTO → <span style={{ color: phase.color }}>{artifact.feedsInto}</span>
                        </div>
                      </div>
                    )}

                    {!isSelected && (
                      <div style={{
                        fontSize: "11px", color: "#404050",
                        fontFamily: "Arial, sans-serif",
                        textAlign: "right",
                      }}>
                        click for detail ↓
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        ))}
      </div>

      {/* Footer */}
      <div style={{
        borderTop: "1px solid #C9A84C22",
        padding: "32px 40px",
        textAlign: "center",
        background: "#0a0a12",
      }}>
        <div style={{ color: "#C9A84C", fontSize: "14px", marginBottom: "8px", fontFamily: "Arial, sans-serif", letterSpacing: "1px" }}>
          AiVass LLC · Purpose. Proof. Permanence.
        </div>
        <div style={{ color: "#404050", fontSize: "12px", fontFamily: "Arial, sans-serif" }}>
          This system is for strategic planning purposes only and does not constitute legal advice. Consult a licensed immigration attorney for filing, legal review, and RFE response.
        </div>
      </div>
    </div>
  );
}
